# Application Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# AI Provider: 'mock_heuristic' (default, no API key needed), 'gemini', or 'openai'
AI_PROVIDER=mock_heuristic
GEMINI_API_KEY=
OPENAI_API_KEY=

# Kubernetes Mode
# Set to 'false' if running inside a real Kubernetes cluster with a ServiceAccount
K8S_MOCK_MODE=true
K8S_IN_CLUSTER=false

# Prometheus
PROMETHEUS_URL=http://prometheus-kube-prometheus-prometheus.monitoring.svc:9090

# Auto-Remediation Controls
AUTO_REMEDIATION_ENABLED=true
REMEDIATION_COOLDOWN_SECONDS=300
MAX_REMEDIATIONS_PER_TARGET=3

# Webhook Alert Channels (Optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
